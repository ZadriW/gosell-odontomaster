# Integração Sankhya (gateway 4R Tech). Login/senha = usuário do próprio Sankhya.
SANKHYA_API_URL=https://app.4rtech.com.br/ftapi/v1/portal-repres
SANKHYA_API_KEY=
SANKHYA_LOGIN=
SANKHYA_PASSWORD=
# Nome do parâmetro que filtra /products por CODPROD (busca de produto avulso).
# SANKHYA_PRODUCT_FILTER_PARAM=
# SANKHYA_TIMEOUT=60
# TOTEM_ERP_WORKER=1
# Prefixo do número do pedido (2 a 4 letras, padrão OM). Use outro (ex.: TS) em
# bancos de teste que enviem pedidos ao mesmo Sankhya, para os números não colidirem.
# TOTEM_ORDER_PREFIX=OM
# IDPEDIDO do Sankhya é inteiro: sequencial 1, 2, 3... somado a esta base. Banco de
# testes que envie ao mesmo Sankhya usa outra faixa (ex.: 900000000).
# TOTEM_IDPEDIDO_BASE=0
# TOTEM_SECRET_KEY=
# TOTEM_DEBUG=0
# TOTEM_BIND=0.0.0.0
# TOTEM_COOKIE_SECURE=0



